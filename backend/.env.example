# Backend - variables de entorno requeridas

# Clave secreta para firmar JWT. OBLIGATORIA — la app no arranca sin ella.
# Generar con: openssl rand -hex 32
JWT_SECRET=

# Minutos de vigencia del access token (opcional, default 30)
JWT_EXPIRE_MINUTES=30

# Días de vigencia del refresh token (opcional, default 7)
JWT_REFRESH_EXPIRE_DAYS=7

# Cadena de conexión a la base de datos
DATABASE_URL=postgresql://usuario:password@localhost:5432/edupredict